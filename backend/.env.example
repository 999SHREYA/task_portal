# Copy to .env and fill in. Never commit the real .env file.

NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://localhost:27017/task_portal
# Frontend origin (CORS + links in emails)
CLIENT_URL=http://localhost:3000

# JWT - use long random strings in production, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# SMTP (Nodemailer). Leave SMTP_HOST empty to only log emails.
# docker-compose sets these to the local Mailpit server.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Task Portal <no-reply@taskportal.local>"

# Cloudinary (task attachments). Leave empty to disable uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
